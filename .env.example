# Sam YT Shorts Engine — secrets
#
# Copy this file to ".env" (same folder) and paste in YOUR OWN keys.
#   cp .env.example .env
#   then edit .env and replace the placeholders below.
# .env is gitignored, so your keys are never committed or shared.

# REQUIRED — ElevenLabs (Scribe transcription + the word-boundary safety re-check,
# and music if you don't use Suno). Bills your account. Get one at https://elevenlabs.io (Profile -> API Keys)
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# OPTIONAL — Suno for music (preferred over ElevenLabs when set; produces modern,
# non-"elevator" beds). The engine targets the sunoapi.org v1 API by default; override
# the base/model in sam-clips-engine/brand_assets.json -> "music" if you use another
# provider. Leave blank to use ElevenLabs music, then the bundled library tracks.
SUNO_API_KEY=
# SUNO_API_BASE=https://api.sunoapi.org
# SUNO_MODEL=V4

# REQUIRED FOR THE CLOUD PIPELINE (sam-clips-engine/cloud/) — Cloudflare R2.
# The cloud engine reads the source video and writes finished clips to R2, because a
# cloud container has no Seagate drive. Skip these if you only run the local pipeline.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT is derived from R2_ACCOUNT_ID unless you set it.
R2_ENDPOINT=

# OPTIONAL — Infisical, if you keep the keys above in a secrets vault instead of a file.
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
